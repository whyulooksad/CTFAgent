{
  "adapter": "tsec",
  "backend": "docker",
  "max_solvers": 3,
  "max_challenges": 6,
  "solver_timeout": 1800,
  "max_retries_per_challenge": 1,
  "retry_value_threshold": 0.6,
  "retry_rarity_threshold": 0.7,
  "poll_interval": 10,
  "llm_priority": false,
  "submit_min_interval": 5,
  "max_submit_per_challenge": 3,
  "dashboard_port": 8081,
  "docker_image": "ctf-solver:latest",
  "resident": false,
  "standby_start": true,
  "state_file": "master_state_tsec.json",
  "log_file": "master_tsec.log",
  "flags_file": "flags_tsec.jsonl"
}
