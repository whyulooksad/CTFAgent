{
  "adapter": "none",
  "backend": "process",
  "max_solvers": 3,
  "max_challenges": 20,
  "solver_timeout": 3600,
  "max_retries_per_challenge": 1,
  "retry_value_threshold": 0.6,
  "retry_rarity_threshold": 0.7,
  "poll_interval": 15,
  "llm_priority": true,
  "llm_priority_effort": "low",
  "submit_min_interval": 10,
  "max_submit_per_challenge": 3,
  "dashboard_port": 8081,
  "docker_image": "ctf-solver:latest",
  "resident": true,
  "state_file": "master_state.json",
  "log_file": "master.log"
}