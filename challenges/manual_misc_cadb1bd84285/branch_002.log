+    end = max((p["t"] for p in later), default=r["t"])
+    close = min((p["t"] for p in endings), default=None)
+    body = b"".join(p["payload"] for p in srv_data)
+    status = re.search(rb"HTTP/1\.[01]\s+(\d+)", body)
