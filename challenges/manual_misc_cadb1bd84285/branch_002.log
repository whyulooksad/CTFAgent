+    print(f"pos={pos:3d} count={len(rr):2d} first={rr[0]['cand']!r} last={rr[-1]['cand']!r} "
+          f"next_gap={(float(positions[pos+1][0]['time'])-float(rr[-1]['time'])) if pos+1 in positions else 0:.6f} "
+          f"tail={timings[-3:]}")
