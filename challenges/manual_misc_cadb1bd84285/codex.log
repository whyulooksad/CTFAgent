+#!/usr/bin/env python3
+import collections
+import ipaddress
+import re
+import struct
+import sys
+from pathlib import Path
+
+
+def packets(path):
+    data = Path(path).read_bytes()
+    magic = data[:4]
+    if magic == b"\xd4\xc3\xb2\xa1":
+        endian, scale = "<", 1_000_000
+    elif magic == b"\xa1\xb2\xc3\xd4":
+        endian, scale = ">", 1_000_000
+    elif magic == b"\x4d\x3c\xb2\xa1":
+        endian, scale = "<", 1_000_000_000
+    elif magic == b"\xa1\xb2\x3c\x4d":
+        endian, scale = ">", 1_000_000_000
+    else:
+        raise ValueError(f"unknown pcap magic {magic.hex()}")
+    _, _, _, _, _, snaplen, network = struct.unpack_from(endian + "HHIIII", data, 4)
+    print(f"pcap network={network} snaplen={snaplen}")
+    off = 24
+    number = 0
+    while off + 16 <= len(data):
+        sec, frac, incl, orig = struct.unpack_from(endian + "IIII", data, off)
+        raw = data[off + 16:off + 16 + incl]
+        off += 16 + incl
+        number += 1
+        yield number, sec + frac / scale, raw
+
+
+def tcp_packet(raw):
+    if not raw or raw[0] >> 4 != 4:
+        return None
+    ihl = (raw[0] & 15) * 4
+    total = struct.unpack_from("!H", raw, 2)[0]
+    if raw[9] != 6 or len(raw) < ihl + 20:
+        return None
+    src = str(ipaddress.ip_address(raw[12:16]))
+    dst = str(ipaddress.ip_address(raw[16:20]))
+    sport, dport, seq, ack, off_flags = struct.unpack_from("!HHIIH", raw, ihl)
+    thl = ((off_flags >> 12) & 15) * 4
+    flags = off_flags & 0x1ff
+    payload = raw[ihl + thl:min(total, len(raw))]
+    return src, sport, dst, dport, seq, ack, flags, payload
+
+
+def main(path):
+    counts = collections.Counter()
+    endpoints = collections.Counter()
+    events = []
+    guesses = []
+    pat = re.compile(
+        rb"substr\(\(select\(text\)from\(wfy_comments\)where\(id=100\)\),"
+        rb"(\d+),1\)=%22(.{1,12}?)%22"
+    )
+    for number, ts, raw in packets(path):
+        pkt = tcp_packet(raw)
+        if not pkt:
+            counts["non_tcp"] += 1
+            continue
+        src, sport, dst, dport, seq, ack, flags, payload = pkt
+        counts["tcp"] += 1
+        endpoints[(src, sport, dst, dport)] += 1
+        if payload:
+            counts["tcp_payload"] += 1
+            first = payload.splitlines()[0][:220]
+            if payload.startswith(b"GET "):
+                counts["http_get"] += 1
+                m = pat.search(payload)
+                if m:
+                    guesses.append((number, ts, src, sport, dst, dport,
+                                    int(m.group(1)), m.group(2).decode("latin1"),
+                                    len(payload)))
+                events.append((number, ts, src, sport, dst, dport, len(payload), first))
+            elif payload.startswith(b"HTTP/1.1"):
+                counts["http_response"] += 1
+                events.append((number, ts, src, sport, dst, dport, len(payload), first))
+    print("counts", dict(counts))
+    print("top directed endpoints")
+    for key, count in endpoints.most_common(12):
+        print(count, key)
+    print(f"guesses={len(guesses)} positions={len(set(x[6] for x in guesses))}")
+    bypos = collections.defaultdict(list)
+    for row in guesses:
+        bypos[row[6]].append(row[7])
+    for pos in sorted(bypos):
+        chars = bypos[pos]
+        print(f"pos {pos:3d}: n={len(chars):3d} sequence={''.join(chars)}")
+    print("first HTTP boundary events")
+    for row in events[:30]:
+        print(row)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1] if len(sys.argv) > 1 else "111.pcap")
