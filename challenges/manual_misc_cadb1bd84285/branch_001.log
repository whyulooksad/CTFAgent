+def parse_http(buf, response=False):
+    """Return HTTP messages as (startline, headers, wire body, decoded body)."""
+    ans, pos = [], 0
+    marker = b"HTTP/" if response else b"GET "
+    while True:
+        start = buf.find(marker, pos)
+        if start < 0:
+            break
+        hend = buf.find(b"\r\n\r\n", start)
+        if hend < 0:
+            break
+        lines = buf[start:hend].split(b"\r\n")
+        headers = {}
+        for line in lines[1:]:
+            if b":" in line:
+                k, v = line.split(b":", 1)
+                headers[k.lower().decode("latin1")] = v.strip().decode("latin1")
+        body_start = hend + 4
+        if headers.get("transfer-encoding", "").lower() == "chunked":
+            p, chunks = body_start, bytearray()
+            try:
+                while True:
+                    e = buf.index(b"\r\n", p)
+                    n = int(buf[p:e].split(b";", 1)[0], 16)
+                    p = e + 2
+                    if n == 0:
+                        p += 2
+                        break
+                    chunks += buf[p:p+n]
+                    p += n + 2
+                wire, nxt = bytes(chunks), p
+            except (ValueError, IndexError):
+                break
+        else:
+            try:
+                n = int(headers.get("content-length", "0"))
+            except ValueError:
+                n = 0
+            wire, nxt = buf[body_start:body_start+n], body_start+n
+            if len(wire) < n:
+                break
+        decoded = wire
+        enc = headers.get("content-encoding", "").lower()
+        try:
+            if enc == "gzip":
+                decoded = gzip.decompress(wire)
+            elif enc == "deflate":
+                decoded = zlib.decompress(wire)
+        except Exception:
+            pass
+        ans.append((lines[0].decode("latin1"), headers, wire, decoded))
+        pos = max(nxt, hend + 4)
+    return ans
 
 
