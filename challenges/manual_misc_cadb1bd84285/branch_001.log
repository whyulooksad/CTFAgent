+def reassemble(parts):
+    """Reassemble one unidirectional TCP byte stream, suppressing retransmits."""
+    out = bytearray()
+    end = None
+    for seq, data in sorted(parts):
+        if not data:
+            continue
+        if end is None:
+            out += data
+            end = seq + len(data)
+        elif seq >= end:
+            if seq > end:
+                out += b"\x00" * (seq - end)
+            out += data
+            end = seq + len(data)
+        elif seq + len(data) > end:
+            out += data[end - seq :]
+            end = seq + len(data)
+    return bytes(out)
 
 
