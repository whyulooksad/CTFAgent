from flask import Flask,request,redirect,abort,render_template,render_template_string
import re
import sys
app=Flask(__name__)


@app.route("/")
def index():
    return render_template("index.html")

@app.errorhandler(404) 
def page_not_found(error):
    blacklist = ["\{\{.*request.*\}\}","\{\{.*%.*\}\}","\{\{.*\..*\}\}","\{\{.*join.*\}\}","\{\{.*\d.*\}\}"]
    for i in blacklist:
        if re.search(i,error.description):
            return render_template_string(render_template("404.html",uri="nonono"+i)), 404
    sys.modules["subprocess"] = "subprocess gone"
    return render_template_string(render_template("404.html",uri=error.description)), 404
    
@app.route("/<uri>")
def not_here(uri):
    abort(404,uri)
        
if __name__ == "__main__":
    app.run(host='0.0.0.0',port=80,debug=0)

