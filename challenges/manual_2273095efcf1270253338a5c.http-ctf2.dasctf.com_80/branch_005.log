+INVALID / {"status": 200, "length": 1709, "location": "", "set_cookie": "", "sha256": "ca94c5bed297e9e1", "flag": false}
+BASE /admin {"status": 404, "length": 539, "location": "", "set_cookie": "", "sha256": "0f43641334075bfc", "flag": false}
+BASE /flag {"status": 404, "length": 538, "location": "", "set_cookie": "", "sha256": "7ba76cc3d2d3c1d8", "flag": false}
+BASE /dashboard {"status": 404, "length": 543, "location": "", "set_cookie": "", "sha256": "ae23fe4237452a41", "flag": false}
