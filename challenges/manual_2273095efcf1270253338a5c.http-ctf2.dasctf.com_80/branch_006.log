)
: > /tmp/branch006_combos.txt
i=0
for q in \""'${queries[@]}"; do
  body="/tmp/branch006_combo_${i}.body"
  meta=$(curl -sS --max-time 12 -o "$body" -w '"'%{http_code} %{size_download} %{time_total} %{redirect_url}' \""'${base}?${q}")
