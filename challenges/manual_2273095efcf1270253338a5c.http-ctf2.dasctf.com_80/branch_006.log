  printf '"'%s | %s | %s | keywords=%s\\n' \""'$q" "$meta" "$hash" "$words" | tee -a /tmp/branch006_combos.txt
  i=$((i+1))
done' in /home/stw/ctf-agent/challenges/manual_2273095efcf1270253338a5c.http-ctf2.dasctf.com_80
