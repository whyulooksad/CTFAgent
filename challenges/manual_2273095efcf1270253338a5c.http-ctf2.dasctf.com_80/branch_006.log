/bin/bash -lc "base='http://2273095efcf1270253338a5c.http-ctf2.dasctf.com/'
queries=(
  'debug=true&source=true'
  'show=true&source=true'
  'action=read&file=%2Fflag'
  'action=read&path=%2Fetc%2Fpasswd'
  'read=%2Fflag&show=true'
