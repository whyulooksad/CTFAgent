exec
/bin/bash -lc "python3 - <<'PY' | tee /tmp/manual_web_highport_scan.txt
import asyncio
HOST='117.21.200.176'
START, END = 10000, 65535
CONCURRENCY=800
TIMEOUT=0.45
open_ports=[]
sem=asyncio.Semaphore(CONCURRENCY)
async def check(port):
    async with sem:
        try:
            r,w=await asyncio.wait_for(asyncio.open_connection(HOST,port),TIMEOUT)
            open_ports.append(port)
            w.close()
            await w.wait_closed()
        except Exception:
            pass
async def main():
    for lo in range(START, END+1, 5000):
        await asyncio.gather(*(check(p) for p in range(lo,min(lo+5000,END+1))))
        print('progress', min(lo+4999,END), 'open_so_far', sorted(open_ports), flush=True)
    print('OPEN_PORTS', sorted(open_ports))
    for port in sorted(open_ports):
        try:
            r,w=await asyncio.wait_for(asyncio.open_connection(HOST,port),2)
            w.write(b'*1\\r\\n"'$4'"\\r\\nPING\\r\\n'); await w.drain()
            data=await asyncio.wait_for(r.read(256),2)
            print('BANNER',port,repr(data))
            w.close(); await w.wait_closed()
        except Exception as e:
            print('BANNER',port,type(e).__name__)
asyncio.run(main())
