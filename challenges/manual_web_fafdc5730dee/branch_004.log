import socket
HOST='117.21.200.176'; PORT=63790

def resp(*parts):
    out=f'*{len(parts)}\\r\\n'.encode()
    for p in parts:
        if isinstance(p,str): p=p.encode()
        out += b'"'$%d'"\\r\\n'%len(p)+p+b'\\r\\n'
    return out

def probe(label, payloads, timeout=4):
    try:
        s=socket.create_connection((HOST,PORT),timeout=timeout)
        s.settimeout(timeout)
        chunks=[]
        for payload in payloads:
            s.sendall(payload)
            try:
                data=s.recv(4096)
            except socket.timeout:
                data=b'<timeout>'
            chunks.append(data)
        s.close()
        print(label, '=>', b' | '.join(chunks).decode('latin1','replace')[:1200])
    except Exception as e:
        print(label, 'EXC', repr(e))

