def req(path, auth=False):
    h=headers.copy()
    if auth: h['Cookie']=cookie
    try:
        r=requests.get(base+path, headers=h, timeout=(2,4), allow_redirects=False)
        return r.status_code, dict(r.headers), r.content[:4096]
    except Exception as e:
        return 'ERR', {'error':type(e).__name__+': '+str(e)[:80]}, b''

def fmt(label,path,st,h,b):
    txt=b.decode('utf-8','replace')
    m=re.search(r'<title>(.*?)</title>',txt,re.I|re.S)
    title=re.sub(r'\\s+',' ',m.group(1)).strip() if m else ''
    snip=re.sub(r'\\s+',' ',txt[:160]).strip()
    return f'{label:6} {st"'!s:>3} len={len(b):<4} type={h.get("Content-Type","")[:32]:<32} loc={h.get("Location","")[:35]:<35} path={path:<28} title={title!r} snip={snip[:80]!r}'"'

b0=req('/__branch_001_no_such_route_404__',False)
b1=req('/__branch_001_no_such_route_404__',True)
print('BASE noauth',fmt('noauth','/__branch_001_no_such_route_404__',*b0))
print('BASE auth  ',fmt('auth','/__branch_001_no_such_route_404__',*b1))
print('INTERESTING')
for p in paths:
    for label,auth in [('noauth',False),('auth',True)]:
        st,h,b=req(p,auth)
        base_resp=b1 if auth else b0
        interesting = (st "'!= base_resp[0]) or (len(b) != len(base_resp[2]))
        if interesting:
            print(fmt(label,p,st,h,b), flush=True)
    time.sleep(0.02)
