from pathlib import Path
import re
root=Path('/tmp/ctf-src.9vgiAJ/src')
sink=re.compile(r'\\b(eval|system|exec|shell_exec|passthru|popen|proc_open)\\s*\\(\\s*\\"'$_(GET|POST|REQUEST|COOKIE)'"\\s*\\[\\s*[\\'\\\"](["'^'"\\'\\\"]+)[\\'\\\"]\\s*\\]',re.I)
assign_tpl=r'\\"'$_{src}'"\\s*\\[\\s*([\\'\\\"]){param}\\1\\s*\\]\\s*='
ifeq=re.compile(r\""'^'"\\s*if\\s*\\(\\s*(['\\\"])(.*?)\\1\\s*(===|==|"'!==|!=)'"\\s*(['\\\"])(.*?)\\4\\s*\\)\\s*\\{?\\s*"'$")
out=[]
for p in root.glob('"'*.php'):
    lines=p.read_text(errors='replace').splitlines()
    block=False
    for i,line in enumerate(lines):
        s=line.strip(); incomment=block or s.startswith(('//','#','*'))
        if not block and '/*' in line and line.index('/*') <= max(line.find('eval'),line.find('system'),line.find('exec')) if max(line.find('eval'),line.find('system'),line.find('exec'))>=0 else False: incomment=True
        if '/*' in line and '*/' not in line: block=True
        if block and '*/' in line: block=False
        m=sink.search(line)
        if not m or incomment: continue
        func,src,param=m.group(1).lower(),m.group(2),m.group(3)
        prev=''
        for j in range(i-1,-1,-1):
            if lines[j].strip(): prev=lines[j].strip(); break
        fm=ifeq.match(prev)
        if fm:
            a,op,b=fm.group(2),fm.group(3),fm.group(5)
            truth=(a==b) if op in ('==','===') else (a"'!=b)
            if not truth: continue
        assigned=[]
        ar=re.compile(assign_tpl.format(src=src,param=re.escape(param)))
        for j in range(i):
            if ar.search(lines[j]): assigned.append((j+1,lines[j].strip()))
        if not assigned:
            out.append((i+1,p.name,func,src,param,prev))
out.sort()
print('"'unassigned_direct_candidates',len(out))
for x in out[:160]: print('\\t'.join(map(str,x)))
