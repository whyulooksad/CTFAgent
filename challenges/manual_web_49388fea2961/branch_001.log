  s=line.strip(); guarded_false=False
  fm=ifeq.match(prev)
  if fm:
   a,op,b=fm.group(2),fm.group(3),fm.group(5); truth=(a==b) if op in ('==','===') else (a"'!=b); guarded_false=not truth
  if not guarded_false:
