   am=assign_sg.match(line)
   if am: sg[(am.group(1),am.group(2))]=False
   vm=assign_var.match(line)
   if vm:
    lhs,rhs=vm.group(1),vm.group(2)
    refs=varref.findall(rhs)
    direct=bool(source.search(rhs)); inherited=next((v for v in refs if taint.get(v,False)),None)
    taint[lhs]=direct or inherited is not None
    origin[lhs]=(f'line {no} direct: {s}' if direct else origin.get(inherited,'?') if inherited else '')
  if s: prev=s
print('candidates',len(cands),'files',len(set(x[0] for x in cands)))
