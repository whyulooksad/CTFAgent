sink_sg=re.compile(r'\\b(eval|assert|system|exec|shell_exec|passthru|popen|proc_open|unserialize|include|include_once|require|require_once)\\s*\\(?\\s*\\"'$_(GET|POST|REQUEST|COOKIE)'"\\s*\\[\\s*[\\'\\\"](["'^'"\\'\\\"]+)[\\'\\\"]',re.I)
ifeq=re.compile(r\""'^'"\\s*if\\s*\\(\\s*(['\\\"])(.*?)\\1\\s*(===|==|"'!==|!=)'"\\s*(['\\\"])(.*?)\\4\\s*\\)\\s*\\{?\\s*"'$")
cands=[]
