from pathlib import Path
import re
root=Path('/tmp/ctf-src.9vgiAJ/src')
sink=re.compile(r'\\b(eval|assert|system|exec|shell_exec|passthru|popen|proc_open|include|include_once|require|require_once|unserialize)\\s*\\(?.*\\"'$_(?:GET|POST|REQUEST|COOKIE|FILES)'"',re.I)
ifeq=re.compile(r\""'^'"\\s*if\\s*\\(\\s*(['\\\"])(.*?)\\1\\s*(===|==|"'!==|!=)'"\\s*(['\\\"])(.*?)\\4\\s*\\)\\s*\\{?\\s*"'$")
counts={'"'direct':0,'guard_false':0,'guard_true':0,'unguarded':0,'comment':0}
cands=[]
for p in root.glob('*.php'):
    lines=p.read_text(errors='replace').splitlines()
    block=False
    code=[]
    for i,line in enumerate(lines):
        s=line.strip()
        wasblock=block
        # basic comment state adequate for generated source
        if block:
            if '*/' in line: block=False
            incomment=True
        elif s.startswith('/*'):
            incomment=True
            if '*/' not in line: block=True
        else: incomment=s.startswith('//') or s.startswith('#') or s.startswith('*')
        if sink.search(line):
            counts['direct']+=1
            if incomment:
                counts['comment']+=1; continue
            prev=''
            for j in range(i-1,-1,-1):
                ps=lines[j].strip()
                if ps and not ps.startswith(('//','#','*')):
                    prev=lines[j]; break
            m=ifeq.match(prev)
            if m:
                a,op,b=m.group(2),m.group(3),m.group(5)
                truth=(a==b) if op in ('==','===') else (a"'!=b)
                counts['"'guard_true' if truth else 'guard_false']+=1
                if truth:cands.append((str(p),i+1,'TRUE_GUARD',prev.strip(),s))
            else:
                counts['unguarded']+=1
                cands.append((str(p),i+1,'NO_SIMPLE_FALSE_GUARD',prev.strip(),s))
print(counts)
print('candidates',len(cands))
for x in cands[:300]: print('\\t'.join(map(str,x)))
