+            data=data,
+            timeout=15,
+        )
+        hit = MARKER in response.text
+        return path.name, mode, response.status_code, len(response.content), hit, ""
+    except Exception as exc:
+        return path.name, mode, 0, 0, False, type(exc).__name__
+
