from pathlib import Path
import re, collections
root=Path('/tmp/ctf-src.9vgiAJ/src')
sink=re.compile(r'\\b(eval|assert|system|exec|preg_replace)\\s*\\(\\s*\\"'$_(GET|POST|REQUEST)'"\\s*\\[\\s*[\\'\\\"](["'^'"\\'\\\"]+)[\\'\\\"]\\s*\\]')
rows=[]
for p in root.glob('*.php'):
    raw=p.read_text(errors='ignore')
    code=re.sub(r'/\\*.*?\\*/', '', raw, flags=re.S)
    code=re.sub(r'//["'^'"\\n]*|#["'^'"\\n]*', '', code)
    for m in sink.finditer(code):
        fn,kind,key=m.groups()
        before=code[:m.start()]
        overwritten=bool(re.search(r'\\"'$_'"'+kind+r'\\s*\\[\\s*[\\'\\\"]'+re.escape(key)+r'[\\'\\\"]\\s*\\]\\s*=', before))
        line=code.count('\\n',0,m.start())+1
        prev=' '.join(code[max(0,m.start()-160):m.start()].split())
        falseguard=bool(re.search(r\"if\\s*\\(\\s*(['\\\"])(["'^'"'\\\"]+)\\1\\s*==+\\s*(['\\\"])(["'^'"'\\\"]+)\\3\\s*\\)\\s*"'$", prev) and (lambda z:z.group(2)!=z.group(4))(re.search(r"if'"\\s*\\(\\s*(['\\\"])(["'^'"'\\\"]+)\\1\\s*==+\\s*(['\\\"])(["'^'"'\\\"]+)\\3\\s*\\)\\s*"'$", prev)))
        rows.append((p.name,line,fn,kind,key,overwritten,falseguard,prev[-100:]))
print('"'total',len(rows))
for label, pred in [('not_overwritten',lambda r:not r[5]),('not_overwritten_not_falseguard',lambda r:not r[5] and not r[6])]:
    rs=[r for r in rows if pred(r)]
    print(label,len(rs),'files',len({r[0] for r in rs}))
    out=Path('/tmp/'+label+'.tsv')
    out.write_text('\\n'.join('\\t'.join(map(str,r)) for r in rs))
print('sample remaining')
for r in [x for x in rows if not x[5] and not x[6]][:80]: print('\\t'.join(map(str,r)))
